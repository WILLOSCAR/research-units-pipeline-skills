  "methodology_note_policy": {
    "placement": "introduction",
    "max_occurrences": 1,
    "required_fields": [
      "candidate_pool",
      "core_set_size",
      "evidence_mode",
      "time_window"
    ]
  },
  "voice_guardrails": {
    "forbidden_stems": [
      "for this run",
      "this review",
      "this survey",
      "the discussion below",
      "what follows",
      "the remaining sections",
      "that methodology note appears once here",
      "evidence assembled here",
      "pipeline",
      "workspace"
    ],
    "allow_self_narration": false,
    "allow_pipeline_voice": false
  },
  "sections": {
    "abstract": {
      "mode": "sentence_bank"
    },
    "introduction": {
